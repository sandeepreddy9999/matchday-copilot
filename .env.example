# Copy this file to .env.local and fill in values for your environment.
# This app never calls the Anthropic API directly with a client-side key,
# since it is deployed as a static site with no backend. Instead it expects
# a small proxy endpoint (e.g. a serverless function) that holds the real
# Anthropic API key server-side and forwards requests to /v1/messages.
#
# If VITE_CLAUDE_PROXY_URL is left unset, the app runs entirely on local
# simulated responses (see src/services/fallbackResponses.ts) so it remains
# fully functional for demos without any backend at all.

VITE_CLAUDE_PROXY_URL=
